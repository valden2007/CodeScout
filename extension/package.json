{
  "name": "codescout-vscode",
  "displayName": "CodeScout",
  "description": "AI-powered code review for local Git changes.",
  "version": "1.1.2",
  "publisher": "valden2007",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/valden2007/CodeScout.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:codescout.scanUncommitted",
    "onCommand:codescout.scanLastCommit",
    "onCommand:codescout.setApiKey",
    "onCommand:codescout.clearApiKey",
    "onCommand:codescout.chooseModel",
    "onCommand:codescout.testSample",
    "onCommand:codescout.cancelScan",
    "onCommand:codescout.scanFull",
    "onCommand:codescout.resetOnboarding",
    "onCommand:codescout.customReview",
    "onCommand:codescout.openSettings",
    "onCommand:codescout.openSettingsPage",
    "onCommand:codescout.resumeAudit",
    "onCommand:codescout.restartAudit"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codescout-explorer",
          "title": "CodeScout",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codescout-explorer": [
        {
          "id": "codescout.panel",
          "type": "webview",
          "name": "Review"
        }
      ]
    },
    "commands": [
      {
        "command": "codescout.scanUncommitted",
        "title": "CodeScout: review uncommitted changes"
      },
      {
        "command": "codescout.scanLastCommit",
        "title": "CodeScout: review last commit"
      },
      {
        "command": "codescout.setApiKey",
        "title": "CodeScout: set API key"
      },
      {
        "command": "codescout.clearApiKey",
        "title": "CodeScout: clear API key"
      },
      {
        "command": "codescout.chooseModel",
        "title": "CodeScout: choose model"
      },
      {
        "command": "codescout.testSample",
        "title": "CodeScout: test on sample"
      },
      {
        "command": "codescout.cancelScan",
        "title": "CodeScout: stop scan"
      },
      {
        "command": "codescout.scanFull",
        "title": "CodeScout: full project audit"
      },
      {
        "command": "codescout.resetOnboarding",
        "title": "CodeScout: сброс онбординга"
      },
      {
        "command": "codescout.customReview",
        "title": "CodeScout: своё ревью с фокусом"
      },
      {
        "command": "codescout.customReview",
        "title": "CodeScout: своё ревью с фокусом"
      },
      {
        "command": "codescout.resumeAudit",
        "title": "CodeScout: продолжить прерванный аудит"
      },
      {
        "command": "codescout.restartAudit",
        "title": "CodeScout: полный аудит заново (сброс чекпоинта)"
      },
      {
        "command": "codescout.reviewSelection",
        "title": "CodeScout: проверить"
      },
      {
        "command": "codescout.openSettings",
        "title": "CodeScout: настройки (нативные)"
      },
      {
        "command": "codescout.openSettingsPage",
        "title": "CodeScout: ключ и модель"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "codescout.reviewSelection",
          "when": "resourceScheme == file",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "CodeScout",
      "properties": {
        "codescout.apiKey": {
          "type": "string",
          "description": "API key for the selected provider. Keep it private; it is stored as a secret-like setting.",
          "scope": "machine",
          "password": true
        },
        "codescout.provider": {
          "type": "string",
          "enum": [
            "gemini",
            "groq",
            "openrouter",
            "github",
            "custom"
          ],
          "default": "gemini",
          "description": "LLM provider used by CodeScout."
        },
        "codescout.model": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "Model name understood by the selected provider."
        },
        "codescout.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional OpenAI-compatible base URL. Set this for Ollama, LM Studio, or another proxy."
        },
        "codescout.maxFiles": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "Лимит файлов на один полный аудит. Всё, что не влезло, выводится в Output отдельной строкой."
        },
        "codescout.docLinks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Ссылки на документацию проекта. Полный аудит подтягивает тексты по ним (лимиты — из настроек docMaxLinks и docMaxKb, таймаут 5с, кэш .codescout/docs-cache.json на 24ч) и добавляет секцию «Документация проекта» в промт."
        },
        "codescout.docMaxKb": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 2048,
          "description": "Максимальный размер одного документа документации в промт (KB). Документ больше — усекается до лимита (начало сохраняется)."
        },
        "codescout.docMaxLinks": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "description": "Максимальное число документационных ссылок, подтягиваемых за один полный аудит."
        },
        "codescout.maxLines": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Максимум строк на файл в аудите. 0 = без лимита: файлы длиннее 800 строк режутся чанками с перекрытием 50 строк, находки дедуплицируются. N > 0 = файлы длиннее N скипаются (для слабых моделей)."
        },
        "codescout.auditScope": {
          "type": "string",
          "default": "",
          "description": "Scope полного аудита: glob-паттерны через запятую (например, src/**, extension/src/**). Пусто = все файлы. Контекстная проверка по ПКМ scope игнорирует."
        },
        "codescout.auditPasses": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 3,
          "description": "Сколько кругов проверки делать на файл в полном аудите (1-3). Со 2-го круга в промт добавляется список находок предыдущих кругов с инструкцией искать пропущенное; находки всех кругов мерджатся с дедупом."
        },
        "codescout.autoResume": {
          "type": "boolean",
          "default": false,
          "description": "Автономный режим (авто-догон): при rate-limit/сети аудит сам возобновляется из чекпоинта с backoff 30с→60с→2мин→5мин, максимум 20 попыток и 3 часа. Остановка пользователем убивает и запрос, и авто-режим. При старте VS Code автостарта нет."
        },
        "codescout.reportLanguage": {
          "type": "string",
          "enum": [
            "ru",
            "en"
          ],
          "default": "ru",
          "description": "Language of report texts (description/suggestion/summary) generated by the model."
        },
        "codescout.showAuditBanner": {
          "type": "boolean",
          "default": true,
          "description": "Показывать welcome-баннер полного аудита при старте окна."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  }
}
