{
  "name": "codescout-vscode",
  "displayName": "CodeScout",
  "description": "AI-powered code review for local Git changes.",
  "version": "0.1.0",
  "publisher": "valden2007",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:codescout.scanUncommitted",
    "onCommand:codescout.scanLastCommit"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codescout.scanUncommitted",
        "title": "CodeScout: review uncommitted changes"
      },
      {
        "command": "codescout.scanLastCommit",
        "title": "CodeScout: review last commit"
      }
    ],
    "configuration": {
      "title": "CodeScout",
      "properties": {
        "codescout.apiKey": {
          "type": "string",
          "description": "Groq API key used for code review. Keep it private; it is stored as a secret-like setting.",
          "scope": "machine",
          "password": true
        },
        "codescout.provider": {
          "type": "string",
          "default": "groq",
          "description": "LLM provider used by CodeScout."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  }
}
