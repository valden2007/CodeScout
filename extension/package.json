{
  "name": "codescout-vscode",
  "displayName": "CodeScout",
  "description": "AI-powered code review for local Git changes.",
  "version": "0.1.0",
  "publisher": "valden2007",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:codescout.scanUncommitted",
    "onCommand:codescout.scanLastCommit"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codescout-explorer",
          "title": "CodeScout",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codescout-explorer": [
        {
          "id": "codescout.panel",
          "type": "webview",
          "name": "Review"
        }
      ]
    },
    "commands": [
      {
        "command": "codescout.scanUncommitted",
        "title": "CodeScout: review uncommitted changes"
      },
      {
        "command": "codescout.scanLastCommit",
        "title": "CodeScout: review last commit"
      }
    ],
    "configuration": {
      "title": "CodeScout",
      "properties": {
        "codescout.apiKey": {
          "type": "string",
          "description": "API key for the selected provider. Keep it private; it is stored as a secret-like setting.",
          "scope": "machine",
          "password": true
        },
        "codescout.provider": {
          "type": "string",
          "enum": ["gemini", "groq", "openrouter", "github", "custom"],
          "default": "gemini",
          "description": "LLM provider used by CodeScout."
        },
        "codescout.model": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "Model name understood by the selected provider."
        },
        "codescout.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional OpenAI-compatible base URL. Set this for Ollama, LM Studio, or another proxy."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  }
}
