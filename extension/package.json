{
  "name": "codescout-vscode",
  "displayName": "CodeScout",
  "description": "Bring-your-own-key AI code review: paste an oc_sk_ key and OpenCode Go with Qwen3.8 Flash is configured automatically. RAG full-project audit, smart chunking, false-positive suppression, local Ollama/LM Studio support.",
  "version": "1.5.0",
  "publisher": "valden2007",
  "license": "MIT",
  "icon": "media/icon.png",
  "categories": [
    "Linters",
    "Machine Learning",
    "Testing"
  ],
  "keywords": [
    "AI",
    "Code Review",
    "LLM",
    "Qwen",
    "Security"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/valden2007/CodeScout"
  },
  "bugs": {
    "url": "https://github.com/valden2007/CodeScout/issues"
  },
  "homepage": "https://github.com/valden2007/CodeScout#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "CodeScout requires full workspace access to analyze code and read Git history."
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:codescout.scanUncommitted",
    "onCommand:codescout.scanLastCommit",
    "onCommand:codescout.setApiKey",
    "onCommand:codescout.clearApiKey",
    "onCommand:codescout.chooseModel",
    "onCommand:codescout.testSample",
    "onCommand:codescout.cancelScan",
    "onCommand:codescout.scanFull",
    "onCommand:codescout.resetOnboarding",
    "onCommand:codescout.customReview",
    "onCommand:codescout.openSettings",
    "onCommand:codescout.openSettingsPage",
    "onCommand:codescout.resumeAudit",
    "onCommand:codescout.resumeAuditOther",
    "onCommand:codescout.restartAudit"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codescout-explorer",
          "title": "CodeScout",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codescout-explorer": [
        {
          "id": "codescout.panel",
          "type": "webview",
          "name": "Review"
        }
      ]
    },
    "commands": [
      {
        "command": "codescout.scanUncommitted",
        "title": "CodeScout: review uncommitted changes"
      },
      {
        "command": "codescout.scanLastCommit",
        "title": "CodeScout: review last commit"
      },
      {
        "command": "codescout.setApiKey",
        "title": "CodeScout: set API key"
      },
      {
        "command": "codescout.clearApiKey",
        "title": "CodeScout: clear API key"
      },
      {
        "command": "codescout.chooseModel",
        "title": "CodeScout: choose model"
      },
      {
        "command": "codescout.testSample",
        "title": "CodeScout: test on sample"
      },
      {
        "command": "codescout.cancelScan",
        "title": "CodeScout: stop scan"
      },
      {
        "command": "codescout.scanFull",
        "title": "CodeScout: full project audit"
      },
      {
        "command": "codescout.resetOnboarding",
        "title": "CodeScout: сброс онбординга"
      },
      {
        "command": "codescout.customReview",
        "title": "CodeScout: своё ревью с фокусом"
      },
      {
        "command": "codescout.customReview",
        "title": "CodeScout: своё ревью с фокусом"
      },
      {
        "command": "codescout.resumeAudit",
        "title": "CodeScout: продолжить прерванный аудит"
      },
      {
        "command": "codescout.resumeAuditOther",
        "title": "CodeScout: догнать прерванный аудит другим провайдером/моделью"
      },
      {
        "command": "codescout.restartAudit",
        "title": "CodeScout: полный аудит заново (сброс чекпоинта)"
      },
      {
        "command": "codescout.reviewSelection",
        "title": "CodeScout: проверить"
      },
      {
        "command": "codescout.openSettings",
        "title": "CodeScout: настройки (нативные)"
      },
      {
        "command": "codescout.openSettingsPage",
        "title": "CodeScout: ключ и модель"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "codescout.reviewSelection",
          "when": "resourceScheme == file",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "%settings.title%",
      "properties": {
        "codescout.apiKey": {
          "type": "string",
          "description": "%apiKey.description%",
          "deprecationMessage": "%apiKey.deprecated%",
          "scope": "machine",
          "password": true
        },
        "codescout.provider": {
          "type": "string",
          "enum": [
            "custom",
            "openai",
            "anthropic",
            "opencode",
            "gemini",
            "groq",
            "github",
            "deepseek",
            "together",
            "sambanova",
            "siliconflow",
            "nvidia",
            "hyperbolic",
            "cerebras",
            "openrouter"
          ],
          "default": "gemini",
          "description": "%provider.description%"
        },
        "codescout.model": {
          "type": "string",
          "default": "gemini-1.5-flash",
          "description": "%model.description%"
        },
        "codescout.baseUrl": {
          "type": "string",
          "default": "",
          "description": "%baseUrl.description%"
        },
        "codescout.maxFiles": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "%maxFiles.description%"
        },
        "codescout.docLinks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%docLinks.description%"
        },
        "codescout.docMaxKb": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 2048,
          "description": "%docMaxKb.description%"
        },
        "codescout.docMaxLinks": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "description": "%docMaxLinks.description%"
        },
        "codescout.docBudgetKb": {
          "type": "number",
          "default": 24,
          "minimum": 8,
          "maximum": 128,
          "description": "%docBudgetKb.description%"
        },
        "codescout.chunkLines": {
          "type": "number",
          "default": 800,
          "minimum": 200,
          "maximum": 800,
          "description": "%chunkLines.description%"
        },
        "codescout.maxRequestKTokens": {
          "type": "number",
          "default": 12,
          "minimum": 4,
          "maximum": 32,
          "description": "%maxRequestKTokens.description%"
        },
        "codescout.maxLines": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%maxLines.description%"
        },
        "codescout.auditScope": {
          "type": "string",
          "default": "",
          "description": "%auditScope.description%"
        },
        "codescout.auditPasses": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 3,
          "description": "%auditPasses.description%"
        },
        "codescout.rateLimitPauses": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 5,
          "description": "%rateLimitPauses.description%"
        },
        "codescout.requestTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 600,
          "description": "%requestTimeout.description%"
        },
        "codescout.fileCooldownSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 30,
          "description": "%fileCooldown.description%"
        },
        "codescout.autoResume": {
          "type": "boolean",
          "default": false,
          "description": "%autoResume.description%"
        },
        "codescout.autoResumeMaxAttempts": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 1000,
          "description": "%autoResumeMaxAttempts.description%"
        },
        "codescout.autoResumeMaxMinutes": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 10000,
          "description": "%autoResumeMaxMinutes.description%"
        },
        "codescout.language": {
          "type": "string",
          "enum": [
            "ru",
            "en"
          ],
          "default": "ru",
          "description": "%language.description%"
        },
        "codescout.showAuditBanner": {
          "type": "boolean",
          "default": true,
          "description": "%showAuditBanner.description%"
        },
        "codescout.uiTheme": {
          "type": "string",
          "enum": [
            "auto",
            "dark",
            "light",
            "custom"
          ],
          "default": "auto",
          "description": "%uiTheme.description%"
        },
        "codescout.customColors": {
          "type": "string",
          "default": "",
          "description": "%customColors.description%"
        },
        "codescout.accentColor": {
          "type": "string",
          "enum": [
            "auto",
            "blue",
            "purple",
            "green",
            "orange",
            "pink"
          ],
          "default": "auto",
          "description": "%accentColor.description%"
        },
        "codescout.uiDensity": {
          "type": "string",
          "enum": [
            "compact",
            "standard"
          ],
          "default": "standard",
          "description": "%uiDensity.description%"
        },
        "codescout.uiFontSize": {
          "type": "string",
          "enum": [
            "s",
            "m",
            "l"
          ],
          "default": "m",
          "description": "%uiFontSize.description%"
        },
        "codescout.showConfidence": {
          "type": "boolean",
          "default": true,
          "description": "%showConfidence.description%"
        },
        "codescout.findingsSort": {
          "type": "string",
          "enum": [
            "severity",
            "file",
            "line"
          ],
          "default": "severity",
          "description": "%findingsSort.description%"
        },
        "codescout.reportTheme": {
          "type": "string",
          "enum": [
            "auto",
            "dark",
            "light"
          ],
          "default": "auto",
          "description": "%reportTheme.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  }
}
