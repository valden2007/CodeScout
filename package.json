{
  "name": "codescout",
  "version": "1.2.0",
  "description": "AI-powered code review for GitHub pull requests and local CLI diffs with Groq BYOK support",
  "keywords": [
    "code-review",
    "ai",
    "llm",
    "github-action",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valden2007/CodeScout.git"
  },
  "bugs": {
    "url": "https://github.com/valden2007/CodeScout/issues"
  },
  "homepage": "https://github.com/valden2007/CodeScout#readme",
  "private": false,
  "type": "commonjs",
  "main": "dist/index.js",
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "codescout": "./dist/cli.js"
  },
  "scripts": {
    "build": "ncc build src/action.ts -o dist && ncc build src/cli.ts -o dist-cli && cp dist-cli/index.js dist/cli.js && rm -rf dist-cli",
    "build:cli": "ncc build src/cli.ts -o dist-cli && cp dist-cli/index.js dist/cli.js && rm -rf dist-cli",
    "cli": "tsx src/cli.ts",
    "cli:scan": "tsx src/cli.ts scan",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "@octokit/rest": "^21.1.0",
    "dotenv": "^16.4.7",
    "ink": "^3.2.0",
    "ink-box": "^2.0.0",
    "ink-spinner": "^4.0.3",
    "ink-table": "^3.0.0",
    "react": "^18.3.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/yargs": "^17.0.35",
    "@vercel/ncc": "^0.38.3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
